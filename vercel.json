{
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/umrah",
      "destination": "/app/?umrah",
      "permanent": false
    }
  ],
  "functions": {
    "api/invest-lead.js": {
      "includeFiles": "landing/investors-deck.pdf"
    }
  }
}
